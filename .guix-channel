;; Channel manifest for this repository.  Adding this repository to a
;; `guix pull' makes its package modules available without -L, and enables
;; the guix/import/ms-ivy.scm updater for `guix refresh'.
;;
;; Commit authentication: history from the introduction commit onward is
;; signed with the OpenPGP key recorded in the dependencies' introduction
;; of the user's channels.scm entry; the public key lives in the 'keyring'
;; branch.  (.guix-channel does not support a top-level introduction field;
;; the introduction must be recorded on the pulling side:
;;   commit 32e8f043573bc1a7b0da7facd23b06f20d199490
;;   fingerprint CA5A 2189 12D3 CA70 E689  3FB9 0A9B 84C3 ADD0 A923)
(channel
 (version 0)
 (directory "modules")
 (keyring-reference "keyring")
  (dependencies
   (channel
    (name 'guix-science-nonfree)
    (url "https://codeberg.org/guix-science/guix-science-nonfree.git")
    (branch "master")
    (commit "b9cc745a1d756cf94de355a12d5742c71230fe7d")
    (introduction
     (channel-introduction
      (version 0)
      (commit "58661b110325fd5d9b40e6f0177cc486a615817e")
      (signer "CA4F 8CF4 37D7 478F DA05  5FD4 4213 7701 1A37 8446"))))
   (channel
    (name 'nonguix)
    (url "https://gitlab.com/nonguix/nonguix")
    (branch "master")
    (commit "cf5e3b8f9f6a2bc8cfc2039cb5153d625a08da6b")
    (introduction
     (channel-introduction
      (version 0)
      (commit "897c1a470da759236cc11798f4e0a5f7d4d59fbc")
      (signer "2A39 3FFF 68F4 EF7A 3D29  12AF 6F51 20A0 22FB B2D5"))))))
