{
  "schema": 1,
  "packages": {
    "kilocode": {
      "module": "kilocode",
      "package": "kilocode",
      "pin": "modules/under-sea/packages/kilocode-pin.scm",
      "version_symbol": "%kilocode-version",
      "upstream": {
        "type": "github",
        "repo": "kilo-org/kilocode",
        "tag_regex": "^v[0-9]"
      },
      "adapter": "bun",
      "autonomy": "L3",
      "tests": [
        "make kilocode",
        "make verify-phase7"
      ],
      "pin_module": "kilocode-pin",
      "source_symbol": "%kilocode-source",
      "hash_format": "base16",
      "tag_template": "v{version}"
    },
    "opencode-v1": {
      "module": "opencode-v1",
      "package": "opencode-v1",
      "pin": "modules/under-sea/packages/opencode-v1-pin.scm",
      "version_symbol": "%opencode-v1-version",
      "upstream": {
        "type": "github",
        "repo": "anomalyco/opencode",
        "tag_regex": "^v1\\."
      },
      "adapter": "bun",
      "autonomy": "L3",
      "tests": [
        "make opencode-v1",
        "make verify-phase7"
      ],
      "pin_module": "opencode-v1-pin",
      "source_symbol": "%opencode-v1-source",
      "hash_format": "base32",
      "tag_template": "v{version}"
    },
    "opencode-v2": {
      "module": "opencode-v2",
      "package": "opencode-v2",
      "pin": "modules/under-sea/packages/opencode-v2-pin.scm",
      "version_symbol": "%opencode-v2-version",
      "upstream": {
        "type": "github",
        "repo": "anomalyco/opencode",
        "tag_regex": "^v2\\."
      },
      "adapter": "bun",
      "autonomy": "L3",
      "tests": [
        "make opencode-v2",
        "make verify-phase7"
      ],
      "pin_module": "opencode-v2-pin",
      "source_symbol": "%opencode-v2-source",
      "hash_format": "base32",
      "tag_template": "v{version}"
    },
    "marimo": {
      "module": "marimo",
      "package": "marimo",
      "pin": "modules/under-sea/packages/marimo-pin.scm",
      "upstream": {
        "type": "pypi",
        "project": "marimo"
      },
      "adapter": "pypi",
      "autonomy": "L2",
      "tests": [
        "make marimo",
        "make verify-standalone"
      ],
      "version_symbol": "%marimo-version",
      "pin_module": "marimo-pin",
      "source_symbol": "%marimo-source",
      "hash_format": "base32"
    }
  }
