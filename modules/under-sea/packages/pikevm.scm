;;; pikevm - an implementation of "Regular Expression Matching: the Virtual
;;; Machine Approach" (Russ Cox) in Rust, packaged from jameysharp/pikevm.
;;; MIT licensed.

(define-module (under-sea packages pikevm)
  #:use-module (guix packages)
  #:use-module (guix git-download)
  #:use-module (guix download)
  #:use-module (guix gexp)
  #:use-module (guix build-system gnu)
  #:use-module ((guix licenses) #:prefix license:)
  #:use-module (gnu packages rust)
  #:use-module (gnu packages pkg-config)
  #:use-module (gnu packages gcc)
  #:use-module (gnu packages commencement)
  #:export (pikevm))

;; Offline crate vendor for the pikevm build (the Cargo.lock closure,
;; generated by cargo vendor at the pinned commit).
(define pikevm-vendor
  (local-file "/home/jinser/models/pikevm-vendor.tar.gz"
              "pikevm-vendor.tar.gz"))

(define-public pikevm
  (package
    (name "pikevm")
    (version "0.1.0")
    (source
     (origin
       (method git-fetch)
       (uri (git-reference
             (url "https://github.com/jameysharp/pikevm")
             (commit "55ccff62fc39fb7745f6dceaf5f19605cafa3dc0")))
       (file-name (git-file-name name version))
       (sha256
        (base32
         "1ciyd6w7xb199kqn5s4sjw3p40wwc4zbyrxmcznws5qzkk8lfgdi"))))
    (build-system gnu-build-system)
    (native-inputs (list rust (list rust "cargo") pkg-config gcc-toolchain
                         pikevm-vendor))
    (arguments
     (list
      #:substitutable? #f
      #:modules '((guix build gnu-build-system) (guix build utils))
      #:phases
      #~(modify-phases %standard-phases
          (delete 'bootstrap)
          (delete 'configure)
          (add-after 'unpack 'unpack-vendor
            (lambda* (#:key inputs #:allow-other-keys)
              (invoke "tar" "xzf" (assoc-ref inputs "pikevm-vendor"))
              (mkdir-p ".cargo")
              (call-with-output-file ".cargo/config.toml"
                (lambda (port)
                  (display "[source.crates-io]\n\
                            replace-with = \"vendored-sources\"\n\n\
                            [source.vendored-sources]\n\
                            directory = \"vendor\"\n\
                            [net]\n\
                            offline = true\n" port)))
              (setenv "CARGO_HOME" (string-append (getcwd) "/guix-cargo-home"))
              (setenv "CC" "gcc")
              (setenv "RUSTFLAGS" "-C linker=gcc")))
          (replace 'build
            (lambda _
              (invoke "cargo" "build" "--release" "--offline" "--locked")))
          (replace 'check
            (lambda _
              (invoke "cargo" "test" "--release" "--offline" "--locked")))
          (replace 'install
            (lambda _
              (let ((bin (string-append #$output "/bin")))
                (install-file "target/release/pikevm" bin)
                (install-file "LICENSE"
                              (string-append #$output
                                             "/share/doc/pikevm"))))))))
    (supported-systems '("x86_64-linux"))
    (properties '((upstream-name . "pikevm")))
    (home-page "https://github.com/jameysharp/pikevm")
    (synopsis "Pike VM regular expression matcher in Rust")
    (description "An implementation of Russ Cox's @emph{Regular Expression
Matching: the Virtual Machine Approach} in Rust, with a lazy DFA layer on
top of the Pike VM for literal-prefixed patterns.  MIT licensed.")
    (license license:expat)))
