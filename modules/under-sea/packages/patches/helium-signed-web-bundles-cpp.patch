+#ifndef COMPONENTS_WEB_PACKAGE_SIGNED_WEB_BUNDLES_RUST_SIGNED_WEB_BUNDLES_RUST_H_
+#define COMPONENTS_WEB_PACKAGE_SIGNED_WEB_BUNDLES_RUST_SIGNED_WEB_BUNDLES_RUST_H_
+
+// guix: the upstream header is generated by crubit from the Rust crate in
+// this directory, which this build cannot run (no cpp_api_from_rust).
+// This is a self-contained C++ reimplementation of the crate's public API
+// as consumed by web_package:
+//  - verify_ed25519_signature / verify_ecdsa_p256_signature, matching
+//    signature_verifier.rs (delegated there to BoringSSL's bssl_crypto),
+//    reimplemented here with BoringSSL directly;
+//  - create_signature_payload, matching signature_verifier.rs
+//    (8-byte big-endian length-prefixed concatenation);
+//  - parse_integrity_block and the IntegrityBlock / SignatureStackEntry /
+//    SignatureType / ParseError types, matching integrity_block.rs
+//    (CBOR parsing via components/cbor).
+
+#include <cstdint>
+#include <cstring>
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/types/expected.h"
+#include "components/cbor/reader.h"
+#include "components/cbor/values.h"
+#include "components/cbor/writer.h"
+#include "third_party/boringssl/src/include/openssl/bn.h"
+#include "third_party/boringssl/src/include/openssl/curve25519.h"
+#include "third_party/boringssl/src/include/openssl/ec.h"
+#include "third_party/boringssl/src/include/openssl/ec_key.h"
+#include "third_party/boringssl/src/include/openssl/ecdsa.h"
+#include "third_party/boringssl/src/include/openssl/evp.h"
+#include "third_party/boringssl/src/include/openssl/mem.h"
+#include "third_party/boringssl/src/include/openssl/obj_mac.h"
+#include "third_party/boringssl/src/include/openssl/sha.h"
+
+namespace web_package::signed_web_bundles::rust {
+
+namespace internal {
+
+inline constexpr uint8_t kMagicBytes[] = {0xF0, 0x9F, 0x96, 0x8B,
+                                          0xF0, 0x9F, 0x93, 0xA6};
+inline constexpr char kV2VersionBytes[] = {'2', 'b', '\0', '\0'};
+inline constexpr size_t kMagicBytesLen = 8;
+inline constexpr size_t kV2VersionBytesLen = 4;
+inline constexpr size_t kTopLevelArrayLength = 4;
+inline constexpr size_t kEcdsaP256PublicKeyLen = 33;
+inline constexpr size_t kEcdsaP256SignatureMinLen = 64;
+inline constexpr size_t kEcdsaP256SignatureMaxLen = 72;
+inline constexpr std::string_view kWebBundleIdAttributeName = "webBundleId";
+inline constexpr std::string_view kEd25519PublicKeyAttributeName =
+    "ed25519PublicKey";
+inline constexpr std::string_view kEcdsaP256PublicKeyAttributeName =
+    "ecdsaP256SHA256PublicKey";
+
+}  // namespace internal
+
+struct SignatureType {
+  enum Tag : int { Ed25519 = 0, EcdsaP256SHA256 = 1, Unknown = 2 };
+  Tag tag;
+};
+
+// Borrowed byte view exposing crubit's to_span() accessor.
+class ByteSlice {
+ public:
+  ByteSlice() = default;
+  ByteSlice(const uint8_t* data, size_t size) : span_(data, size) {}
+  base::span<const uint8_t> to_span() const { return span_; }
+  const uint8_t* begin() const { return span_.data(); }
+  const uint8_t* end() const { return span_.data() + span_.size(); }
+
+ private:
+  base::span<const uint8_t> span_;
+};
+
+struct SignatureStackEntry {
+  std::vector<uint8_t> attributes_cbor;
+  SignatureType signature_type;
+  ByteSlice public_key;
+  ByteSlice signature;
+};
+
+class WebBundleId {
+ public:
+  WebBundleId() = default;
+  explicit WebBundleId(std::string_view id) : id_(id) {}
+  std::string_view to_string_view() const { return id_; }
+
+ private:
+  std::string_view id_;
+};
+
+struct IntegrityBlock {
+  uint64_t size = 0;
+  WebBundleId web_bundle_id;
+  std::vector<uint8_t> attributes_cbor;
+  std::vector<SignatureStackEntry> signature_stack;
+};
+
+struct ParseError {
+  bool is_version_error = false;
+  struct Message {
+    std::string_view as_str() const { return text; }
+    std::string text;
+  } message;
+
+  static ParseError Format(std::string text) {
+    return ParseError{false, Message{std::move(text)}};
+  }
+  static ParseError Version(std::string text) {
+    return ParseError{true, Message{std::move(text)}};
+  }
+};
+
+inline bool verify_ed25519_signature(
+    const base::span<const uint8_t> public_key,
+    const base::span<const uint8_t> signature,
+    const base::span<const uint8_t> message) {
+  if (public_key.size() != ED25519_PUBLIC_KEY_LEN ||
+      signature.size() != ED25519_SIGNATURE_LEN) {
+    return false;
+  }
+  return ED25519_verify(message.data(), message.size(), signature.data(),
+                        public_key.data()) == 1;
+}
+
+inline bool verify_ecdsa_p256_signature(
+    const base::span<const uint8_t> public_key,
+    const base::span<const uint8_t> signature,
+    const base::span<const uint8_t> message) {
+  std::unique_ptr<EC_GROUP, decltype(&EC_GROUP_free)> group(
+      EC_GROUP_new_by_curve_name(NID_X9_62_prime256v1), &EC_GROUP_free);
+  if (!group) {
+    return false;
+  }
+  std::unique_ptr<EC_POINT, decltype(&EC_POINT_free)> point(
+      EC_POINT_new(group.get()), &EC_POINT_free);
+  if (!point ||
+      !EC_POINT_oct2point(group.get(), point.get(), public_key.data(),
+                          public_key.size(), nullptr)) {
+    return false;
+  }
+  std::unique_ptr<EC_KEY, decltype(&EC_KEY_free)> key(EC_KEY_new(),
+                                                      &EC_KEY_free);
+  if (!key || !EC_KEY_set_group(key.get(), group.get()) ||
+      !EC_KEY_set_public_key(key.get(), point.get())) {
+    return false;
+  }
+  // signature_verifier.rs verifies over the raw message with SHA-256 as
+  // the ECDSA digest (bssl_crypto::ecdsa::P256).
+  uint8_t digest[32];
+  SHA256(message.data(), message.size(), digest);
+  return ECDSA_verify(0, digest, sizeof(digest), signature.data(),
+                      static_cast<int>(signature.size()),
+                      key.get()) == 1;
+}
+
+inline std::vector<uint8_t> create_signature_payload(
+    const base::span<const uint8_t> unsigned_web_bundle_hash,
+    const base::span<const uint8_t> integrity_block_cbor,
+    const base::span<const uint8_t> attributes_cbor) {
+  std::vector<uint8_t> payload;
+  payload.reserve(24 + unsigned_web_bundle_hash.size() +
+                  integrity_block_cbor.size() + attributes_cbor.size());
+  for (const auto* item :
+       {&unsigned_web_bundle_hash, &integrity_block_cbor, &attributes_cbor}) {
+    uint64_t length = item->size();
+    for (int shift = 56; shift >= 0; shift -= 8) {
+      payload.push_back(static_cast<uint8_t>((length >> shift) & 0xFF));
+    }
+    payload.insert(payload.end(), item->begin(), item->end());
+  }
+  return payload;
+}
+
+namespace internal {
+
+inline bool TagsMatch(const cbor::Value& value, const uint8_t* tag,
+                      size_t tag_len) {
+  return value.is_bytestring() && value.GetBytestring().size() == tag_len &&
+         std::memcmp(value.GetBytestring().data(), tag, tag_len) == 0;
+}
+
+// Parses one signature stack entry ([attributes map, signature bytestring]).
+// On success fills `entry` and returns the serialized attributes CBOR.
+inline std::optional<std::vector<uint8_t>> ParseSignatureInfo(
+    const cbor::Value& value,
+    SignatureStackEntry& entry,
+    ParseError& error) {
+  if (!value.is_array()) {
+    error = ParseError::Format(
+        "Each signature stack entry must be a CBOR array.");
+    return std::nullopt;
+  }
+  const cbor::Value::ArrayValue& sig_array = value.GetArray();
+  if (sig_array.size() != 2) {
+    error = ParseError::Format(
+        "Each signature stack entry must contain exactly two elements.");
+    return std::nullopt;
+  }
+  const cbor::Value& attributes = sig_array[0];
+  const cbor::Value& signature_value = sig_array[1];
+  if (!attributes.is_map() || !signature_value.is_bytestring()) {
+    error = ParseError::Format("Malformed signature stack entry.");
+    return std::nullopt;
+  }
+
+  const cbor::Value* ed25519_key = nullptr;
+  const cbor::Value* ecdsa_key = nullptr;
+  for (const auto& kv : attributes.GetMap()) {
+    if (!kv.first.is_string()) {
+      continue;
+    }
+    const std::string& key = kv.first.GetString();
+    if (key == kEd25519PublicKeyAttributeName) {
+      ed25519_key = &kv.second;
+    } else if (key == kEcdsaP256PublicKeyAttributeName) {
+      ecdsa_key = &kv.second;
+    }
+  }
+
+  std::vector<uint8_t> public_key;
+  SignatureType signature_type;
+  if (ed25519_key && ecdsa_key) {
+    error = ParseError::Format("Multiple key types for one signature.");
+    return std::nullopt;
+  }
+  if (ed25519_key) {
+    if (!ed25519_key->is_bytestring()) {
+      error = ParseError::Format("Invalid ED25519 key.");
+      return std::nullopt;
+    }
+    signature_type = SignatureType{SignatureType::Ed25519};
+    public_key = ed25519_key->GetBytestring();
+  } else if (ecdsa_key) {
+    if (!ecdsa_key->is_bytestring()) {
+      error = ParseError::Format("Invalid ECDSA key.");
+      return std::nullopt;
+    }
+    signature_type = SignatureType{SignatureType::EcdsaP256SHA256};
+    public_key = ecdsa_key->GetBytestring();
+  } else {
+    signature_type = SignatureType{SignatureType::Unknown};
+  }
+
+  // validate_keys_and_signature().
+  switch (signature_type.tag) {
+    case SignatureType::Ed25519:
+      if (public_key.size() != ED25519_PUBLIC_KEY_LEN) {
+        error = ParseError::Format(
+            "The Ed25519 public key does not have the correct length. "
+            "Expected 32 bytes, but received " +
+            std::to_string(public_key.size()) + " bytes.");
+        return std::nullopt;
+      }
+      if (signature_value.GetBytestring().size() != ED25519_SIGNATURE_LEN) {
+        error = ParseError::Format(
+            "The signature has the wrong length. Expected 64, but got " +
+            std::to_string(signature_value.GetBytestring().size()) +
+            " bytes.");
+        return std::nullopt;
+      }
+      break;
+    case SignatureType::EcdsaP256SHA256: {
+      if (public_key.size() != kEcdsaP256PublicKeyLen) {
+        error = ParseError::Format(
+            "The ECDSA P-256 public key does not have the correct length. "
+            "Expected 33 bytes, but received " +
+            std::to_string(public_key.size()) + " bytes.");
+        return std::nullopt;
+      }
+      std::unique_ptr<EC_GROUP, decltype(&EC_GROUP_free)> group(
+          EC_GROUP_new_by_curve_name(NID_X9_62_prime256v1), &EC_GROUP_free);
+      std::unique_ptr<EC_POINT, decltype(&EC_POINT_free)> point(
+          EC_POINT_new(group.get()), &EC_POINT_free);
+      if (!group || !point ||
+          !EC_POINT_oct2point(group.get(), point.get(), public_key.data(),
+                              public_key.size(), nullptr)) {
+        error = ParseError::Format(
+            "Unable to parse a valid ECDSA P-256 key from the given bytes.");
+        return std::nullopt;
+      }
+      const size_t signature_length = signature_value.GetBytestring().size();
+      if (signature_length < kEcdsaP256SignatureMinLen ||
+          signature_length > kEcdsaP256SignatureMaxLen) {
+        error = ParseError::Format(
+            "The ECDSA P-256 SHA-256 signature does not have the correct "
+            "length. Expected from 64 to 72 bytes, but received " +
+            std::to_string(signature_length) + " bytes.");
+        return std::nullopt;
+      }
+      break;
+    }
+    case SignatureType::Unknown:
+      break;
+  }
+
+  std::optional<std::vector<uint8_t>> attributes_cbor =
+      cbor::Writer::Write(attributes);
+  if (!attributes_cbor) {
+    error = ParseError::Format("Error serializing signature attributes.");
+    return std::nullopt;
+  }
+
+  entry.attributes_cbor = *attributes_cbor;
+  entry.signature_type = signature_type;
+  entry.public_key = ByteSlice(public_key.data(), public_key.size());
+  entry.signature =
+      ByteSlice(signature_value.GetBytestring().data(),
+                signature_value.GetBytestring().size());
+  return attributes_cbor;
+}
+
+}  // namespace internal
+
+inline base::expected<IntegrityBlock, ParseError> parse_integrity_block(
+    const std::vector<uint8_t>& input) {
+  std::optional<cbor::Value> parsed =
+      cbor::Reader::Read(base::span<const uint8_t>(input));
+  if (!parsed) {
+    return base::unexpected(
+        ParseError::Format("Error parsing integrity block as CBOR."));
+  }
+  if (!parsed->is_array()) {
+    return base::unexpected(
+        ParseError::Format("Integrity block is not a CBOR array."));
+  }
+  const cbor::Value::ArrayValue& top_array = parsed->GetArray();
+  if (top_array.size() != internal::kTopLevelArrayLength) {
+    return base::unexpected(ParseError::Format(
+        "Invalid integrity block array length: expected 4, got " +
+        std::to_string(top_array.size()) + "."));
+  }
+
+  // 1. Magic bytes
+  if (!internal::TagsMatch(top_array[0], internal::kMagicBytes,
+                           internal::kMagicBytesLen)) {
+    return base::unexpected(
+        ParseError::Format("Unexpected magic bytes."));
+  }
+
+  // 2. Version bytes
+  if (!internal::TagsMatch(top_array[1],
+                           reinterpret_cast<const uint8_t*>(
+                               internal::kV2VersionBytes),
+                           internal::kV2VersionBytesLen)) {
+    return base::unexpected(
+        ParseError::Version("Unexpected version bytes."));
+  }
+
+  // 3. Attributes map
+  if (!top_array[2].is_map()) {
+    return base::unexpected(ParseError::Format(
+        "Integrity block attributes must be a map."));
+  }
+  const std::string* web_bundle_id = nullptr;
+  for (const auto& kv : top_array[2].GetMap()) {
+    if (kv.first.is_string() &&
+        kv.first.GetString() == internal::kWebBundleIdAttributeName &&
+        kv.second.is_string()) {
+      web_bundle_id = &kv.first.GetString();
+      break;
+    }
+  }
+  if (!web_bundle_id) {
+    return base::unexpected(ParseError::Format(
+        "`webBundleId` integrity block attribute is missing or malformed."));
+  }
+
+  // 4. Signature stack
+  if (!top_array[3].is_array()) {
+    return base::unexpected(
+        ParseError::Format("Signature stack must be an array."));
+  }
+  const cbor::Value::ArrayValue& signatures = top_array[3].GetArray();
+  if (signatures.empty()) {
+    return base::unexpected(ParseError::Format(
+        "The signature stack must contain at least one signature."));
+  }
+
+  IntegrityBlock block;
+  block.size = input.size();
+  block.web_bundle_id = WebBundleId(*web_bundle_id);
+  std::optional<std::vector<uint8_t>> attributes_cbor =
+      cbor::Writer::Write(top_array[2]);
+  if (!attributes_cbor) {
+    return base::unexpected(
+        ParseError::Format("Error serializing integrity block attributes."));
+  }
+  block.attributes_cbor = *attributes_cbor;
+
+  for (size_t i = 0; i < signatures.size(); ++i) {
+    SignatureStackEntry entry;
+    ParseError error;
+    if (!internal::ParseSignatureInfo(signatures[i], entry, error)) {
+      return base::unexpected(std::move(error));
+    }
+    if (i == 0 && entry.signature_type.tag == SignatureType::Unknown) {
+      return base::unexpected(ParseError::Format(
+          "Unknown cipher type of the first signature."));
+    }
+    block.signature_stack.push_back(std::move(entry));
+  }
+
+  return block;
+}
+
+}  // namespace web_package::signed_web_bundles::rust
