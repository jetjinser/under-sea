+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_FONTS_FONT_FORMAT_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_FONTS_FONT_FORMAT_H_
+
+// guix: the upstream header is generated by crubit from
+// opentype/format_check.rs, which this build cannot run (no
+// cpp_api_from_rust).  This is a self-contained C++ reimplementation of
+// format_check.rs: it parses the sfnt/ttc table directory and reads the
+// COLR and avar versions, matching the Rust behaviour including its
+// failure-to-default semantics.
+
+#include <cstdint>
+#include <cstring>
+#include <optional>
+#include <utility>
+#include <vector>
+
+#include "base/containers/span.h"
+
+namespace font_format {
+
+namespace internal {
+
+inline constexpr uint32_t MakeTag(const char (&tag)[5]) {
+  return static_cast<uint32_t>(static_cast<uint8_t>(tag[0])) << 24 |
+         static_cast<uint32_t>(static_cast<uint8_t>(tag[1])) << 16 |
+         static_cast<uint32_t>(static_cast<uint8_t>(tag[2])) << 8 |
+         static_cast<uint8_t>(tag[3]);
+}
+
+inline constexpr uint32_t kTagTtcf = MakeTag("ttcf");
+inline constexpr uint32_t kTagColr = MakeTag("COLR");
+inline constexpr uint32_t kTagAvar = MakeTag("avar");
+inline constexpr uint32_t kTagCbdt = MakeTag("CBDT");
+inline constexpr uint32_t kTagCblc = MakeTag("CBLC");
+inline constexpr uint32_t kTagEbdt = MakeTag("EBDT");
+inline constexpr uint32_t kTagEblc = MakeTag("EBLC");
+inline constexpr uint32_t kTagCff2 = MakeTag("CFF2");
+inline constexpr uint32_t kTagSbix = MakeTag("sbix");
+inline constexpr uint32_t kTagFvar = MakeTag("fvar");
+
+inline bool ReadU16(const base::span<const uint8_t> bytes,
+                    size_t offset,
+                    uint16_t& value) {
+  if (offset + 2 > bytes.size()) {
+    return false;
+  }
+  value = static_cast<uint16_t>(static_cast<uint16_t>(bytes[offset]) << 8 |
+                                bytes[offset + 1]);
+  return true;
+}
+
+inline bool ReadU32(const base::span<const uint8_t> bytes,
+                    size_t offset,
+                    uint32_t& value) {
+  if (offset + 4 > bytes.size()) {
+    return false;
+  }
+  value = static_cast<uint32_t>(bytes[offset]) << 24 |
+          static_cast<uint32_t>(bytes[offset + 1]) << 16 |
+          static_cast<uint32_t>(bytes[offset + 2]) << 8 |
+          bytes[offset + 3];
+  return true;
+}
+
+struct TableRecord {
+  uint32_t tag;
+  uint32_t offset;
+  uint32_t length;
+};
+
+// Parses an sfnt table directory located at `base_offset` and appends its
+// table records to `tables`.  Returns false on malformed input.
+inline bool ParseTableDirectory(const base::span<const uint8_t> bytes,
+                                size_t base_offset,
+                                std::vector<TableRecord>& tables) {
+  uint32_t sfnt_version = 0;
+  if (!ReadU32(bytes, base_offset, sfnt_version)) {
+    return false;
+  }
+  if (sfnt_version != 0x00010000u && sfnt_version != MakeTag("OTTO") &&
+      sfnt_version != MakeTag("true")) {
+    return false;
+  }
+  uint16_t num_tables = 0;
+  if (!ReadU16(bytes, base_offset + 4, num_tables)) {
+    return false;
+  }
+  const size_t records = base_offset + 12;
+  for (uint16_t i = 0; i < num_tables; ++i) {
+    const size_t record = records + static_cast<size_t>(i) * 16;
+    uint32_t tag = 0;
+    uint32_t offset = 0;
+    uint32_t length = 0;
+    if (!ReadU32(bytes, record, tag) ||
+        !ReadU32(bytes, record + 8, offset) ||
+        !ReadU32(bytes, record + 12, length)) {
+      return false;
+    }
+    if (static_cast<size_t>(offset) + length > bytes.size()) {
+      return false;
+    }
+    tables.push_back({tag, offset, length});
+  }
+  return true;
+}
+
+// Resolves the table directory of the first font in `bytes`, mirroring
+// format_check.rs' make_font_ref_internal() (single font or first font of
+// a collection).
+inline bool MakeFontRef(const base::span<const uint8_t> bytes,
+                        std::vector<TableRecord>& tables) {
+  uint32_t tag = 0;
+  if (!ReadU32(bytes, 0, tag)) {
+    return false;
+  }
+  if (tag != kTagTtcf) {
+    return ParseTableDirectory(bytes, 0, tables);
+  }
+  uint32_t num_fonts = 0;
+  if (!ReadU32(bytes, 8, num_fonts) || num_fonts == 0) {
+    return false;
+  }
+  uint32_t first_offset = 0;
+  if (!ReadU32(bytes, 12, first_offset)) {
+    return false;
+  }
+  return ParseTableDirectory(bytes, first_offset, tables);
+}
+
+inline const TableRecord* FindTable(const std::vector<TableRecord>& tables,
+                                    uint32_t tag) {
+  for (const TableRecord& record : tables) {
+    if (record.tag == tag) {
+      return &record;
+    }
+  }
+  return nullptr;
+}
+
+}  // namespace internal
+
+class FontFormatInfo {
+ public:
+  FontFormatInfo() = default;
+  FontFormatInfo(std::vector<uint32_t> table_tags,
+                 std::optional<uint16_t> color_version,
+                 std::optional<std::pair<uint16_t, uint16_t>> avar_version)
+      : table_tags_(std::move(table_tags)),
+        color_version_(color_version),
+        avar_version_(avar_version) {}
+
+ private:
+  friend bool has_tags(const FontFormatInfo&, uint32_t);
+  friend bool has_tags(const FontFormatInfo&, uint32_t, uint32_t);
+  friend bool is_colrv0(const FontFormatInfo&);
+  friend bool is_colrv1(const FontFormatInfo&);
+  friend bool is_avar2(const FontFormatInfo&);
+
+  std::optional<std::vector<uint32_t>> table_tags_;
+  std::optional<uint16_t> color_version_;
+  std::optional<std::pair<uint16_t, uint16_t>> avar_version_;
+};
+
+inline bool has_tags(const FontFormatInfo& info, uint32_t tag) {
+  if (!info.table_tags_.has_value()) {
+    return false;
+  }
+  for (uint32_t existing : *info.table_tags_) {
+    if (existing == tag) {
+      return true;
+    }
+  }
+  return false;
+}
+
+inline bool has_tags(const FontFormatInfo& info, uint32_t tag, uint32_t tag2) {
+  return has_tags(info, tag) && has_tags(info, tag2);
+}
+
+inline FontFormatInfo get_font_format_info(
+    const base::span<const uint8_t> font_bytes) {
+  std::vector<internal::TableRecord> tables;
+  if (!internal::MakeFontRef(font_bytes, tables)) {
+    return FontFormatInfo();
+  }
+  std::vector<uint32_t> tags;
+  tags.reserve(tables.size());
+  for (const internal::TableRecord& record : tables) {
+    tags.push_back(record.tag);
+  }
+  std::optional<uint16_t> color_version;
+  if (const internal::TableRecord* colr =
+          internal::FindTable(tables, internal::kTagColr)) {
+    uint16_t version = 0;
+    if (internal::ReadU16(font_bytes, colr->offset, version)) {
+      color_version = version;
+    }
+  }
+  std::optional<std::pair<uint16_t, uint16_t>> avar_version;
+  if (const internal::TableRecord* avar =
+          internal::FindTable(tables, internal::kTagAvar)) {
+    uint16_t major = 0;
+    uint16_t minor = 0;
+    if (internal::ReadU16(font_bytes, avar->offset, major) &&
+        internal::ReadU16(font_bytes, avar->offset + 2, minor)) {
+      avar_version = std::pair<uint16_t, uint16_t>(major, minor);
+    }
+  }
+  return FontFormatInfo(std::move(tags), color_version, avar_version);
+}
+
+inline bool is_variable(const FontFormatInfo& info) {
+  return has_tags(info, internal::kTagFvar);
+}
+
+inline bool is_sbix(const FontFormatInfo& info) {
+  return has_tags(info, internal::kTagSbix);
+}
+
+inline bool is_cbdt_cblc(const FontFormatInfo& info) {
+  return has_tags(info, internal::kTagCbdt, internal::kTagCblc);
+}
+
+inline bool is_ebdt_eblc(const FontFormatInfo& info) {
+  return has_tags(info, internal::kTagEbdt, internal::kTagEblc);
+}
+
+inline bool is_cff2(const FontFormatInfo& info) {
+  return has_tags(info, internal::kTagCff2);
+}
+
+inline bool is_colrv0(const FontFormatInfo& info) {
+  return info.color_version_ == std::optional<uint16_t>(0);
+}
+
+inline bool is_colrv1(const FontFormatInfo& info) {
+  return info.color_version_ == std::optional<uint16_t>(1);
+}
+
+inline bool is_avar2(const FontFormatInfo& info) {
+  return info.avar_version_.has_value() &&
+         info.avar_version_->first == 2;
+}
+
+}  // namespace font_format
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_FONTS_FONT_FORMAT_H_
