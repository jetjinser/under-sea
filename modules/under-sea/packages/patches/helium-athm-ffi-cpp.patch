+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_CRUBIT_SUPPORT_RS_STD_SLICE_REF_H_
+#define THIRD_PARTY_CRUBIT_SUPPORT_RS_STD_SLICE_REF_H_
+
+// guix: minimal reimplementation of crubit's rs_std::SliceRef, matching
+// the interface consumed by components/private_verification_tokens
+// (construction from spans, arrays and containers).
+
+#include <cstddef>
+#include <cstdint>
+
+#include "base/containers/span.h"
+
+namespace rs_std {
+
+template <typename T>
+class SliceRef {
+ public:
+  SliceRef() = default;
+  SliceRef(const T* data, size_t size) : data_(data), size_(size) {}
+  explicit SliceRef(base::span<const T> span) : data_(span.data()), size_(span.size()) {}
+  template <typename Container>
+  explicit SliceRef(const Container& container)
+      : data_(container.data()), size_(container.size()) {}
+  const T* data() const { return data_; }
+  size_t size() const { return size_; }
+
+ private:
+  const T* data_ = nullptr;
+  size_t size_ = 0;
+};
+
+}  // namespace rs_std
+
+#endif  // THIRD_PARTY_CRUBIT_SUPPORT_RS_STD_SLICE_REF_H_
