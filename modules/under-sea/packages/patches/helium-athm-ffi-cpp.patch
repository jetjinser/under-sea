+#ifndef COMPONENTS_PRIVATE_VERIFICATION_TOKENS_COMMON_ATHM_FFI_ATHM_FFI_H_
+#define COMPONENTS_PRIVATE_VERIFICATION_TOKENS_COMMON_ATHM_FFI_ATHM_FFI_H_
+
+// guix: the upstream header is generated by crubit from the ATHM Rust
+// crate (Anonymous Tokens with Hidden Metadata), which this build cannot
+// run (no cpp_api_from_rust).  Private Verification Tokens is an
+// experimental feature, so this shim keeps the types compilable while
+// disabling the protocol: try_new() never constructs a client and
+// finalize() always fails with InvalidInput, which
+// PrivacyPassAthmBatchRequest surfaces as
+// kClientRequestGenerationFailed / kClientFinalizeFailed.  The feature
+// is disabled rather than weakened.
+
+#include <cstdint>
+#include <optional>
+#include <utility>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "third_party/crubit/support/rs_std/slice_ref.h"
+
+namespace private_verification_tokens {
+
+namespace athm_ffi {
+
+// Minimal borrowed-byte range providing to_span() for the call sites.
+class ByteSlice {
+ public:
+  ByteSlice() = default;
+  const uint8_t* data() const { return nullptr; }
+  size_t size() const { return 0; }
+  const uint8_t* begin() const { return data(); }
+  const uint8_t* end() const { return data(); }
+  ByteSlice to_span() const { return *this; }
+};
+
+}  // namespace athm_ffi
+
+class AthmStatus {
+ public:
+  enum class Code : int { InvalidInput = 0, OperationFailed = 1 };
+
+  static AthmStatus MakeInvalidInput() {
+    return AthmStatus(Code::InvalidInput);
+  }
+  static AthmStatus MakeOperationFailed() {
+    return AthmStatus(Code::OperationFailed);
+  }
+  bool operator==(const AthmStatus& other) const { return code == other.code; }
+
+ private:
+  explicit AthmStatus(Code code) : code(code) {}
+  Code code;
+};
+
+template <typename T, typename E>
+class Result {
+ public:
+  Result(T value) : value_(std::move(value)), has_value_(true) {}
+  Result(E error) : error_(std::move(error)), has_value_(false) {}
+  bool has_value() const { return has_value_; }
+  T& operator*() & { return value_; }
+  E& error() & { return error_; }
+
+ private:
+  T value_;
+  E error_;
+  bool has_value_;
+};
+
+// Stub client: try_new() never constructs one, so the methods below are
+// unreachable at runtime and only need to compile.
+class PrivacyPassBatchClient {
+ public:
+  template <typename... Args>
+  static std::optional<PrivacyPassBatchClient> try_new(Args&&...) {
+    return std::nullopt;
+  }
+
+  athm_ffi::ByteSlice request_body() const { return athm_ffi::ByteSlice(); }
+
+  Result<std::vector<std::vector<uint8_t>>, AthmStatus> finalize(
+      rs_std::SliceRef<const uint8_t>) const {
+    return Result<std::vector<std::vector<uint8_t>>, AthmStatus>(
+        AthmStatus::MakeInvalidInput());
+  }
+};
+
+}  // namespace private_verification_tokens
+
+#endif  // COMPONENTS_PRIVATE_VERIFICATION_TOKENS_COMMON_ATHM_FFI_ATHM_FFI_H_
