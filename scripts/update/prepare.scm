#!/usr/bin/env guile
!#
(use-modules (common)
             (ice-9 format)
             (ice-9 match)
             (json)
             (srfi srfi-1))

(define (flag? args flag) (and (member flag args) #t))
(define (option args name default)
  (let loop ((rest args))
    (cond ((null? rest) default)
          ((string=? (car rest) name) (cadr rest))
          (else (loop (cdr rest))))))

(define (scheme-string value)
  (format #f "~s" value))

(define (download url dest)
  (run-command "curl" "-fsSL" "--retry" "3" "--retry-delay" "2"
               "--max-time" "600" "-o" dest url))

(define (run-command . args)
  (let ((status (apply system* args)))
    (unless (zero? status)
      (error "command failed" args status))))

(define (pypi-sdist project)
  (let* ((text (run/check-output "curl" "-fsSL" "--max-time" "30"
                                 (string-append
                                  "https://pypi.org/pypi/" project "/json")))
         (data (json->scm (open-input-string text)))
         (version (assoc-ref (assoc-ref data "info") "version"))
         (urls (vector->list (assoc-ref data "urls")))
         (sdist (find (lambda (entry)
                        (string=? (assoc-ref entry "packagetype") "sdist"))
                      urls)))
    (unless sdist (error "no sdist" project))
    (cons version (assoc-ref sdist "url"))))

(define (github-url pkg version)
  (let* ((upstream (assoc-ref pkg "upstream"))
         (tag (string-append
               (assoc-ref pkg "tag_template") "")))
    (string-append "https://codeload.github.com/"
                   (assoc-ref upstream "repo") "/tar.gz/refs/tags/"
                   (string-replace (assoc-ref pkg "tag_template")
                                   "{version}" version))))

(define (string-replace str old new)
  (let ((idx (string-contains str old)))
    (if idx
        (string-append (substring str 0 idx) new
                       (substring str (+ idx (string-length old))))
        str)))

(define (render-pin pkg version url file digest)
  (let* ((module (assoc-ref pkg "pin_module"))
         (vsym (assoc-ref pkg "version_symbol"))
         (ssym (assoc-ref pkg "source_symbol"))
         (fmt (assoc-ref pkg "hash_format"))
         (ctor (if (string=? fmt "base16")
                   "base16-string->bytevector" "base32"))
         (import (if (string=? fmt "base16") "base16" "base32")))
    (string-append
     ";;; Generated by scripts/update/prepare.scm; do not edit.\n"
     "(define-module (under-sea packages " module ")\n"
     "  #:use-module (guix packages)\n"
     "  #:use-module (guix download)\n"
     "  #:use-module (guix " import ")\n"
     "  #:export (" vsym " " ssym "))\n\n"
     "(define-public " vsym " " (scheme-string version) ")\n\n"
     "(define-public " ssym "\n"
     "  (origin\n"
     "    (method url-fetch)\n"
     "    (uri " (scheme-string url) ")\n"
     "    (file-name " (scheme-string file) ")\n"
     "    (sha256\n"
     "     (" ctor " " (scheme-string digest) "))))\n")))

(define (main args)
  (let* ((name (option args "--package" #f))
         (version (option args "--version" #f))
         (workdir (option args "--workdir" "/var/tmp/under-sea-update"))
         (apply? (flag? args "--apply"))
         (verify? (flag? args "--verify"))
         (json? (flag? args "--json"))
         (packages (manifest-packages))
         (pkg (and name (assoc-ref packages name))))
    (unless pkg (error "unknown package" name))
    (let* ((upstream (assoc-ref pkg "upstream"))
           (type (assoc-ref upstream "type"))
           (version (or version
                        (assoc-ref (detect-package name pkg) 'latest)))
           (workdir (string-append workdir "/" name "-" version))
           (pin (assoc-ref pkg "pin"))
           (pin-module (assoc-ref pkg "pin_module")))
      (unless (and version pin-module (assoc-ref pkg "source_symbol"))
        (error "package lacks pin metadata" name))
      (run-command "mkdir" "-p" workdir)
      (let* ((source
              (cond
               ((string=? type "github")
                (let ((url (github-url pkg version)))
                  (cons version
                        (cons url (string-append name "-" version ".tar.gz")))))
               ((string=? type "pypi")
                (let ((entry (pypi-sdist (assoc-ref upstream "project"))))
                  (cons (car entry)
                        (cons (cdr entry) (basename (cdr entry))))))
               (else (error "unsupported upstream" type))))
             (url (cadr source))
             (file (cddr source))
             (tarball (string-append workdir "/" file))
             (fmt (assoc-ref pkg "hash_format"))
             (hash-flag (if (string=? fmt "base16") "base16" "nix-base32"))
             (digest (begin
                       (download url tarball)
                       (string-trim-both
                        (run/check-output "guix" "hash" "-H" "sha256"
                                          "-f" hash-flag tarball))))
             (rendered (render-pin pkg version url file digest))
             (target (string-append root "/" pin)))
        (call-with-output-file (string-append workdir "/" pin-module ".scm")
          (lambda (port) (display rendered port)))
        (when apply?
          (call-with-output-file target
            (lambda (port) (display rendered port))))
        (if json?
            (display (scm->json-string
                      `((package . ,name) (version . ,version)
                        (url . ,url) (sha256 . ,digest)
                        (applied . ,apply?))))
            (format #t "~a ~a -> ~a~%" name (if apply? "applied" "prepared")
                    version))
        (when verify?
          (unless apply? (error "--verify requires --apply"))
          (run-command "guix" "time-machine" "-C" "channels.scm" "--"
                       "build" "-L" "modules" "--no-substitutes" "-e"
                       (string-append "(@ (under-sea packages "
                                      (assoc-ref pkg "module") ") "
                                      (assoc-ref pkg "package") ")")))))))

(main (cdr (command-line)))
