#!/usr/bin/env guile
!#
(use-modules (common)
             (ice-9 format)
             (ice-9 match)
             (json)
             (srfi srfi-1))

(define (flag? args flag) (and (member flag args) #t))
(define (option args name default)
  (let loop ((rest args))
    (cond ((null? rest) default)
          ((string=? (car rest) name) (cadr rest))
          (else (loop (cdr rest))))))
(define (replace-all str old new)
  (let loop ((str str))
    (let ((idx (string-contains str old)))
      (if idx
          (loop (string-append (substring str 0 idx) new
                               (substring str (+ idx (string-length old)))))
          str))))
(define (run-command . args)
  (let ((status (apply system* args)))
    (unless (zero? status) (error "command failed" args status))))
(define (scheme-string value) (format #f "~s" value))
(define (asset-url pkg tag asset version)
  (string-append "https://github.com/"
                 (assoc-ref (assoc-ref pkg "upstream") "repo")
                 "/releases/download/" tag "/"
                 (replace-all (assoc-ref asset "file") "{version}" version)))
(define (main args)
  (let* ((name (option args "--package" #f))
         (version (option args "--version" #f))
         (workdir (option args "--workdir" "/var/tmp/under-sea-update"))
         (apply? (flag? args "--apply"))
         (verify? (flag? args "--verify"))
         (json? (flag? args "--json"))
         (packages (manifest-packages))
         (pkg (and name (assoc-ref packages name))))
    (unless pkg (error "unknown package" name))
    (let* ((upstream (assoc-ref pkg "upstream"))
           (version (or version
                        (assoc-ref (detect-package name pkg) 'latest)))
           (tag (replace-all (assoc-ref pkg "tag_template") "{version}" version))
           (assets (vector->list (assoc-ref upstream "assets")))
           (workdir (string-append workdir "/" name "-" version)))
      (run-command "mkdir" "-p" workdir)
      (let* ((rows
              (map (lambda (asset)
                     (let* ((file (replace-all (assoc-ref asset "file")
                                               "{version}" version))
                            (url (asset-url pkg tag asset version))
                            (tarball (string-append workdir "/" file))
                            (digest (begin
                                      (run-command "curl" "-fsSL" "--retry" "3"
                                                   "--max-time" "600" "-o" tarball url)
                                      (string-trim-both
                                       (run/check-output
                                        "guix" "hash" "-H" "sha256"
                                        "-f" "base16" tarball)))))
                       (list (assoc-ref asset "symbol") file url digest)))
                   assets))
             (text
              (string-append
               ";;; Generated by scripts/update/release.scm; do not edit.\n"
               "(define-module (under-sea packages " (assoc-ref pkg "pin_module") ")\n"
               "  #:use-module (guix packages)\n"
               "  #:use-module (guix download)\n"
               "  #:use-module (guix base16)\n"
               "  #:export (" (assoc-ref pkg "version_symbol") " "
               (string-join (map car rows) " ") "))\n\n"
               "(define-public " (assoc-ref pkg "version_symbol") " "
               (scheme-string version) ")\n\n"
               (string-join
                (map (lambda (row)
                       (string-append
                        "(define-public " (car row) "\n"
                        "  (origin\n"
                        "    (method url-fetch)\n"
                        "    (uri " (scheme-string (caddr row)) ")\n"
                        "    (file-name " (scheme-string (cadr row)) ")\n"
                        "    (sha256\n"
                        "     (base16-string->bytevector "
                        (scheme-string (cadddr row)) "))))\n"))
                     rows)
                "\n"))))
        (call-with-output-file (string-append workdir "/" (assoc-ref pkg "pin_module") ".scm")
          (lambda (port) (display text port)))
        (when apply?
          (call-with-output-file (string-append root "/" (assoc-ref pkg "pin"))
            (lambda (port) (display text port))))
        (if json?
            (display (scm->json-string
                      `((package . ,name) (version . ,version)
                        (assets . ,(length rows)) (applied . ,apply?))))
            (format #t "~a ~a -> ~a~%" name (if apply? "applied" "prepared") version))
        (when verify?
          (unless apply? (error "--verify requires --apply"))
          (run-command "guix" "time-machine" "-C" "channels.scm" "--"
                       "build" "-L" "modules" "--no-substitutes" "-e"
                       (string-append "(@ (under-sea packages "
                                      (assoc-ref pkg "module") ") "
                                      (assoc-ref pkg "package") ")")))))))

(main (cdr (command-line)))
