(define-module (common)
  #:use-module (json)
  #:use-module (ice-9 match)
  #:use-module (ice-9 optargs)
  #:use-module (ice-9 popen)
  #:use-module (ice-9 rdelim)
  #:use-module (ice-9 regex)
  #:use-module (ice-9 textual-ports)
  #:use-module (srfi srfi-1)
  #:use-module (srfi srfi-13)
  #:export (root manifest-path exemptions-path status-path
            read-json manifest-packages package-names package-ref
            current-version load-exemptions doc-expressions
            audit-report coverage-report run/check-output
            version-key version< tag-version select-tag github-tags
            pypi-version detect-package render-pin))

(define root
  (let ((here (dirname
               (or (current-filename)
                   (search-path %load-path "common.scm")
                   (error "common.scm not found on %load-path")))))
    (canonicalize-path (string-append here "/../.."))))

(define (path . parts)
  (string-append root "/" (string-join parts "/")))

(define manifest-path (path "planning/update-manifest.json"))
(define exemptions-path (path "planning/update-exemptions.json"))
(define status-path (path "STATUS.md"))

(define (read-json file)
  (call-with-input-file file (lambda (port) (json->scm port))))

(define (manifest-packages)
  (assoc-ref (read-json manifest-path) "packages"))

(define (package-names)
  (sort (map car (manifest-packages)) string<?))

(define (package-ref name)
  (assoc-ref (manifest-packages) name))

(define (read-text file)
  (call-with-input-file file get-string-all))

(define (current-version pkg)
  (let* ((file (path (assoc-ref pkg "pin")))
         (text (read-text file))
         (symbol (regexp-quote (assoc-ref pkg "version_symbol")))
         (rx (make-regexp
              (string-append "\\(define(-public)?[ \t]+" symbol
                             "[ \t]+\"([^\"]+)\"\\)")))
         (match (regexp-exec rx text)))
    (unless match
      (error "cannot find version" (assoc-ref pkg "version_symbol") file))
    (match:substring match 2)))

(define (load-exemptions)
  (let* ((data (read-json exemptions-path))
         (packages (assoc-ref data "packages")))
    (unless (equal? (assoc-ref data "schema") 1)
      (error "unsupported exemption schema"))
    (vector->list packages)))

(define (doc-expressions)
  (let ((text (read-text status-path))
        (rx (make-regexp
             "\\(@ \\(under-sea packages ([^)]+)\\) ([^) \t]+)\\)")))
    (let loop ((start 0) (acc '()))
      (let ((m (regexp-exec rx text start)))
        (if m
            (loop (match:end m)
                  (cons (cons (match:substring m 1)
                              (match:substring m 2))
                        acc))
            (reverse acc))))))

(define (scheme-string value)
  (format #f "~s" value))

(define (render-pin pkg version url file digest)
  (let* ((module (assoc-ref pkg "pin_module"))
         (vsym (assoc-ref pkg "version_symbol"))
         (ssym (assoc-ref pkg "source_symbol"))
         (fmt (assoc-ref pkg "hash_format"))
         (ctor (if (string=? fmt "base16")
                   "base16-string->bytevector" "base32"))
         (import (if (string=? fmt "base16") "base16" "base32")))
    (string-append
     ";;; Generated by scripts/update/prepare.scm; do not edit.\n"
     "(define-module (under-sea packages " module ")\n"
     "  #:use-module (guix packages)\n"
     "  #:use-module (guix download)\n"
     "  #:use-module (guix " import ")\n"
     "  #:export (" vsym " " ssym "))\n\n"
     "(define-public " vsym " " (scheme-string version) ")\n\n"
     "(define-public " ssym "\n"
     "  (origin\n"
     "    (method url-fetch)\n"
     "    (uri " (scheme-string url) ")\n"
     "    (file-name " (scheme-string file) ")\n"
     "    (sha256\n"
     "     (" ctor " " (scheme-string digest) "))))\n")))

(define (pair-key pkg)
  (cons (assoc-ref pkg "module") (assoc-ref pkg "package")))

(define* (audit-report #:key (check-docs? #t))
  (let* ((manifest (manifest-packages))
         (exemptions (load-exemptions))
         (manifest-keys (map (lambda (entry) (pair-key (cdr entry))) manifest))
         (exemption-keys (map pair-key exemptions))
         (inventory (delete-duplicates (append manifest-keys exemption-keys)))
         (errors '()))
    (for-each
     (lambda (key)
       (when (member key exemption-keys)
         (set! errors
               (cons (format #f "duplicate manifest/exemption: ~a/~a"
                             (car key) (cdr key))
                     errors))))
     manifest-keys)
    (when check-docs?
      (for-each
       (lambda (key)
         (unless (member key inventory)
           (set! errors
                 (cons (format #f "STATUS expression not classified: ~a/~a"
                               (car key) (cdr key))
                       errors))))
       (doc-expressions)))
    `((manifest . ,(length manifest))
      (exemptions . ,(length exemptions))
      (inventory . ,(length inventory))
      (errors . ,(reverse errors)))))

(define (coverage-report)
  (let* ((manifest (manifest-packages))
         (exemptions (load-exemptions))
         (rows (append
                (map (lambda (entry)
                       (let ((pkg (cdr entry)))
                         `((package . ,(car entry))
                           (module . ,(assoc-ref pkg "module"))
                           (level . ,(assoc-ref pkg "autonomy"))
                           (adapter . ,(assoc-ref pkg "adapter"))
                           (source . "manifest"))))
                     manifest)
                (map (lambda (pkg)
                       `((package . ,(assoc-ref pkg "package"))
                         (module . ,(assoc-ref pkg "module"))
                         (level . ,(assoc-ref pkg "level"))
                         (adapter . "exempt")
                         (source . "exemption")))
                     exemptions)))
         (levels (make-hash-table)))
    (for-each
     (lambda (row)
       (let* ((level (assoc-ref row 'level))
              (old (hash-ref levels level 0)))
         (hash-set! levels level (+ old 1))))
     rows)
    `((inventory . ,(length rows))
      (levels . ,(sort (hash-map->list cons levels)
                       (lambda (a b) (string<? (car a) (car b)))))
      (rows . ,(sort rows
                     (lambda (a b)
                       (let ((la (assoc-ref a 'level))
                             (lb (assoc-ref b 'level)))
                         (if (string=? la lb)
                             (string<? (assoc-ref a 'package)
                                       (assoc-ref b 'package))
                             (string<? la lb)))))))))

(define (run/check-output program . args)
  (let* ((port (apply open-pipe* OPEN_READ program args))
         (output (get-string-all port))
         (status (close-pipe port)))
    (unless (zero? status)
      (error "command failed" program args status))
    output))

(define prerelease-rx (make-regexp "-(alpha|beta|rc|pre|dev)([.\\-]|$)" regexp/icase))

(define (version-key text)
  (map string->number (map match:substring (list-matches "[0-9]+" text))))

(define (version< a b)
  (let loop ((a (version-key a)) (b (version-key b)))
    (cond ((and (null? a) (null? b)) #f)
          ((null? a) #t)
          ((null? b) #f)
          ((< (car a) (car b)) #t)
          ((> (car a) (car b)) #f)
          (else (loop (cdr a) (cdr b))))))

(define* (tag-version tag #:optional version-regex)
  (if version-regex
      (let ((m (regexp-exec (make-regexp version-regex) tag)))
        (and m (match:substring m 1)))
      (let ((m (regexp-exec (make-regexp "^[^0-9]*([0-9].*)$") tag)))
        (and m (match:substring m 1)))))

(define* (select-tag tags tag-regex #:key (allow-prerelease? #f))
  (let* ((rx (make-regexp tag-regex))
         (candidates
          (filter (lambda (tag)
                    (and (regexp-exec rx tag)
                         (or allow-prerelease?
                             (not (regexp-exec prerelease-rx tag)))))
                  tags)))
    (and (pair? candidates)
         (fold (lambda (tag best)
                 (if (version< best tag) tag best))
               (car candidates)
               (cdr candidates)))))

(define (github-tags repo)
  (let* ((output (run/check-output
                  "git" "ls-remote" "--tags"
                  (string-append "https://github.com/" repo ".git")))
         (tags (map (lambda (line)
                      (let ((ref (cadr (string-split line #\tab))))
                        (and (string-prefix? "refs/tags/" ref)
                             (not (string-suffix? "^{}" ref))
                             (substring ref 10))))
                    (filter (lambda (line) (not (string-null? line)))
                            (string-split output #\newline)))))
    (filter identity tags)))

(define (pypi-version project)
  (let* ((json (run/check-output
                "curl" "-fsSL" "--max-time" "30"
                (string-append "https://pypi.org/pypi/" project "/json")))
         (data (json->scm (open-input-string json))))
    (assoc-ref (assoc-ref data "info") "version")))

(define (detect-package name pkg)
  (let* ((current (current-version pkg))
         (upstream (assoc-ref pkg "upstream"))
         (type (assoc-ref upstream "type"))
         (tag #f)
         (latest
          (cond
           ((or (string=? type "github") (string=? type "github-release"))
            (set! tag (select-tag
                       (github-tags (assoc-ref upstream "repo"))
                       (assoc-ref upstream "tag_regex")
                       #:allow-prerelease?
                       (assoc-ref upstream "allow_prerelease")))
            (and tag (tag-version tag (assoc-ref upstream "version_regex"))))
           ((string=? type "pypi")
            (pypi-version (assoc-ref upstream "project")))
           (else #f)))
         (status (cond ((not latest) "error")
                       ((version< current latest) "outdated")
                       (else "current"))))
    `((package . ,name)
      (current . ,current)
      (latest . ,latest)
      (tag . ,tag)
      (status . ,status)
      (autonomy . ,(assoc-ref pkg "autonomy"))
      (adapter . ,(assoc-ref pkg "adapter"))
      (pin . ,(assoc-ref pkg "pin")))))
